<Page
    x:Class="TellerApp.Views.CurrencyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <Grid Background="#B7B7B7" Padding="40">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Text="CURRENCY"
            FontSize="42"
            FontWeight="Bold"
            Foreground="White"
            HorizontalAlignment="Center"
            Margin="0,0,0,30"/>

        <ListView
            x:Name="CurrencyListView"
            Grid.Row="1"
            SelectionMode="Single"
            Margin="0,0,0,20">

            <ListView.Header>
                <Grid Padding="12" Background="#2C2C2C">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Валют" Foreground="White" FontWeight="Bold" FontSize="16"/>
                    <TextBlock Grid.Column="1" Text="Нэр" Foreground="White" FontWeight="Bold" FontSize="16"/>
                    <TextBlock Grid.Column="2" Text="Авах ханш" Foreground="White" FontWeight="Bold" FontSize="16"/>
                    <TextBlock Grid.Column="3" Text="Зарах ханш" Foreground="White" FontWeight="Bold" FontSize="16"/>
                </Grid>
            </ListView.Header>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="10" Background="White" Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>

                        <TextBox
                            Grid.Column="0"
                            Text="{Binding Code, Mode=TwoWay}"
                            FontSize="16"
                            Margin="5,0"/>

                        <TextBox
                            Grid.Column="1"
                            Text="{Binding Name, Mode=TwoWay}"
                            FontSize="16"
                            Margin="5,0"/>

                        <TextBox
                            Grid.Column="2"
                            Text="{Binding BuyRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            FontSize="16"
                            Margin="5,0"/>

                        <TextBox
                            Grid.Column="3"
                            Text="{Binding SellRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            FontSize="16"
                            Margin="5,0"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            Spacing="15">

            <Button
                Content="Refresh"
                Width="130"
                Height="45"
                Click="RefreshButton_Click"/>

            <Button
                Content="Selected Update"
                Width="170"
                Height="45"
                Click="UpdateSelectedButton_Click"/>

            <Button
                Content="Update All"
                Width="150"
                Height="45"
                Click="UpdateAllButton_Click"/>
        </StackPanel>

        <TextBlock
            x:Name="StatusText"
            Grid.Row="3"
            Text=""
            Foreground="Lime"
            FontSize="16"
            HorizontalAlignment="Center"
            Margin="0,20,0,0"/>

    </Grid>
</Page>