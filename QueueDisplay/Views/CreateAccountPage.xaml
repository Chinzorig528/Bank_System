<Page
    x:Class="QueueDisplay.Views.CreateAccountPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#F3F4F6">

    <Grid>

        <Border
            Width="450"
            Padding="35"
            Background="White"
            CornerRadius="20"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <StackPanel Spacing="18">

                <TextBlock
                    Text="Create New Account"
                    FontSize="30"
                    FontWeight="Bold"
                    Foreground="#111827"/>

                <!-- ACCOUNT NUMBER -->

                <TextBlock
                    Text="Account Number"
                    FontWeight="SemiBold"/>

                <TextBox
                    x:Name="AccountNumberBox"
                    Height="45"
                    PlaceholderText="Enter account number"/>

                <!-- INITIAL BALANCE -->

                <TextBlock
                    Text="Initial Balance"
                    FontWeight="SemiBold"/>

                <TextBox
                    x:Name="BalanceBox"
                    Height="45"
                    PlaceholderText="Enter initial balance"/>

                <!-- BUTTON -->

                <Button
                    Content="Create Account"
                    Height="50"
                    Background="#059669"
                    Foreground="White"
                    FontWeight="Bold"
                    Click="Create_Click"/>

                <!-- RESULT -->

                <TextBlock
                    x:Name="ResultText"
                    Text="Waiting..."
                    FontWeight="SemiBold"
                    TextWrapping="Wrap"/>

            </StackPanel>

        </Border>

    </Grid>

</Page>