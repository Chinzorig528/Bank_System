<Page
    x:Class="QueueDisplay.Views.TransferPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#F3F4F6">

    <ScrollViewer>

        <Grid Padding="30">

            <StackPanel
                Width="500"
                Spacing="25"
                HorizontalAlignment="Center">

                <!-- ========================= -->
                <!-- ACCOUNT BALANCE -->
                <!-- ========================= -->

                <Border
                    Background="White"
                    CornerRadius="20"
                    Padding="30">

                    <StackPanel Spacing="15">

                        <TextBlock
                            Text="Check Balance"
                            FontSize="28"
                            FontWeight="Bold"/>

                        <TextBox
                            x:Name="BalanceAccountBox"
                            Height="45"
                            PlaceholderText="Account number"/>

                        <Button
                            Content="Load Balance"
                            Height="45"
                            Background="#2563EB"
                            Foreground="White"
                            Click="LoadBalance_Click"/>

                        <TextBlock
                            x:Name="BalanceText"
                            Text="Balance: ₮0"
                            FontSize="20"
                            FontWeight="Bold"
                            Foreground="#2563EB"/>
                    </StackPanel>

                </Border>

                <!-- ========================= -->
                <!-- DEPOSIT -->
                <!-- ========================= -->

                <Border
                    Background="White"
                    CornerRadius="20"
                    Padding="30">

                    <StackPanel Spacing="15">

                        <TextBlock
                            Text="Deposit"
                            FontSize="28"
                            FontWeight="Bold"/>

                        <TextBox
                            x:Name="DepositAccountBox"
                            Height="45"
                            PlaceholderText="Account number"/>

                        <TextBox
                            x:Name="DepositAmountBox"
                            Height="45"
                            PlaceholderText="Amount"/>

                        <Button
                            Content="Deposit"
                            Height="45"
                            Background="#059669"
                            Foreground="White"
                            Click="Deposit_Click"/>

                        <TextBlock
                            x:Name="DepositResultText"
                            Text="Waiting..."/>
                    </StackPanel>

                </Border>

                <!-- ========================= -->
                <!-- WITHDRAW -->
                <!-- ========================= -->

                <Border
                    Background="White"
                    CornerRadius="20"
                    Padding="30">

                    <StackPanel Spacing="15">

                        <TextBlock
                            Text="Withdraw"
                            FontSize="28"
                            FontWeight="Bold"/>

                        <TextBox
                            x:Name="WithdrawAccountBox"
                            Height="45"
                            PlaceholderText="Account number"/>

                        <TextBox
                            x:Name="WithdrawAmountBox"
                            Height="45"
                            PlaceholderText="Amount"/>

                        <Button
                            Content="Withdraw"
                            Height="45"
                            Background="#DC2626"
                            Foreground="White"
                            Click="Withdraw_Click"/>

                        <TextBlock
                            x:Name="WithdrawResultText"
                            Text="Waiting..."/>
                    </StackPanel>

                </Border>

                <!-- ========================= -->
                <!-- TRANSFER -->
                <!-- ========================= -->

                <Border
                    Background="White"
                    CornerRadius="20"
                    Padding="30">

                    <StackPanel Spacing="15">

                        <TextBlock
                            Text="Transfer Money"
                            FontSize="28"
                            FontWeight="Bold"/>

                        <TextBox
                            x:Name="FromAccountBox"
                            Height="45"
                            PlaceholderText="From account"/>

                        <TextBox
                            x:Name="ToAccountBox"
                            Height="45"
                            PlaceholderText="To account"/>

                        <TextBox
                            x:Name="TransferAmountBox"
                            Height="45"
                            PlaceholderText="Amount"/>

                        <Button
                            Content="Transfer"
                            Height="45"
                            Background="#7C3AED"
                            Foreground="White"
                            Click="Transfer_Click"/>

                        <TextBlock
                            x:Name="TransferResultText"
                            Text="Waiting..."/>
                    </StackPanel>

                </Border>

            </StackPanel>

        </Grid>

    </ScrollViewer>

</Page>